# ============================================================================
# Sesión — variables de entorno
#
# Copiar este archivo a `.env` y reemplazar los placeholders por valores reales.
# NO commitear .env: está en .gitignore.
# ============================================================================

# ----------------------------------------------------------------------------
# Base de datos (Neon PostgreSQL)
# ----------------------------------------------------------------------------
# Cadena de conexión completa. Incluir sslmode=require para Neon.
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# ----------------------------------------------------------------------------
# Auth.js v5
# ----------------------------------------------------------------------------
# Secreto para firmar/cifrar sesiones. Generar con:
#   openssl rand -base64 32
AUTH_SECRET="reemplazar-por-openssl-rand-base64-32"

# URL base de la app. En producción, el dominio público (https://...).
NEXTAUTH_URL="http://localhost:3001"

# ----------------------------------------------------------------------------
# Twilio WhatsApp (subcuenta dedicada a Sesión)
# ----------------------------------------------------------------------------
# Account SID de la subcuenta (no el de la cuenta master).
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Auth Token de la subcuenta. Rotar si se filtra.
TWILIO_AUTH_TOKEN="reemplazar-por-token-de-la-subcuenta"

# Número de WhatsApp emisor, con prefijo `whatsapp:` y código de país.
TWILIO_WHATSAPP_FROM="whatsapp:+598XXXXXXXXX"

# ----------------------------------------------------------------------------
# Cron de recordatorios
# ----------------------------------------------------------------------------
# Protege el endpoint que dispara los recordatorios programados.
# Generar con: openssl rand -base64 32
CRON_SECRET="reemplazar-por-openssl-rand-base64-32"

# ----------------------------------------------------------------------------
# Seed (solo desarrollo)
# ----------------------------------------------------------------------------
# Protege el endpoint de seed y define la contraseña del usuario inicial.
# NO setear estas variables en producción.
# Generar con: openssl rand -base64 32  (secret) / openssl rand -base64 16 (pwd)
SEED_SECRET="reemplazar-por-openssl-rand-base64-32"
SEED_USER_PASSWORD="reemplazar-por-openssl-rand-base64-16"

# ----------------------------------------------------------------------------
# Sentry (OPCIONAL)
# ----------------------------------------------------------------------------
# Si estas variables no se setean, Sentry no se activa y la app sigue
# funcionando normal. Útil para dev local y previews.
#
# SENTRY_DSN se usa del lado server; NEXT_PUBLIC_SENTRY_DSN se expone al
# browser (de ahí el prefijo NEXT_PUBLIC_). Suelen ser el mismo DSN.
SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# Módulo grabación + IA
PROCESSING_SECRET=           # Secret para callback de La Escondida (generar con: openssl rand -base64 32)

# ----------------------------------------------------------------------------
# Cifrado en reposo de notas clínicas (AES-256-GCM)
# ----------------------------------------------------------------------------
# Clave de cifrado para notas clínicas (transcripcion, notaSoap, datosEstructurados).
# Generar con: openssl rand -base64 32
# CRÍTICO: si se pierde, las notas existentes no se pueden recuperar.
NOTES_ENCRYPTION_KEY=
