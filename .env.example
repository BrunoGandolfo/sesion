# ============================================================================
# Sesión — variables de entorno
#
# Copiar a `.env` y reemplazar los placeholders. NO commitear .env (.gitignore).
#
# Esta lista es exactamente lo que el código lee de process.env. Si agregás una
# variable nueva en src/, agregala acá el mismo día: un .env.example incompleto
# se descubre en producción.
#
# Convención: "OPCIONAL" = la app arranca y funciona sin ella (con el
# comportamiento que dice el comentario). Todo lo demás es obligatorio.
# ============================================================================

# ----------------------------------------------------------------------------
# Base de datos (Neon PostgreSQL)
# ----------------------------------------------------------------------------
# Conexión de la app. Incluir sslmode=require para Neon.
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# La base de los tests de integración va en .env.test (ver .env.test.example):
# los tests la VACÍAN con TRUNCATE entre casos y sólo aceptan un host local
# salvo PERMITIR_BASE_REMOTA_DE_TEST=1.

# ----------------------------------------------------------------------------
# Cifrado en reposo de notas clínicas (AES-256-GCM)
# ----------------------------------------------------------------------------
# Clave de transcripcion, nota SOAP, datosEstructurados y contexto clínico.
# 32 bytes en base64: openssl rand -base64 32
# CRÍTICO: si se pierde, las notas existentes no se pueden recuperar.
NOTES_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# Auth.js v5
# ----------------------------------------------------------------------------
# Secreto para firmar/cifrar las sesiones: openssl rand -base64 32
AUTH_SECRET="reemplazar-por-openssl-rand-base64-32"

# OPCIONAL. URL base de la app. En Vercel se deduce del request; setearla solo
# si la app corre detrás de un proxy que reescribe el host.
AUTH_URL="http://localhost:3001"

# ----------------------------------------------------------------------------
# Endpoints máquina a máquina (worker Python)
# ----------------------------------------------------------------------------
# Bearer token de /api/sesion-clinica/{callback,pendientes,aprobadas-sin-contexto}
# y del GET de contexto-clinico. Mismo valor que en processor/.env.
# Generar con: openssl rand -base64 32
PROCESSING_SECRET=

# OPCIONAL. Minutos sin cambios tras los cuales el lease de una sesión en
# "procesando" se considera vencido y otro worker la puede reclamar. Default: 45.
LEASE_MINUTES=

# OPCIONAL. Reclamos tras los cuales la sesión pasa a "error" en vez de
# entregarse de nuevo. Default: 3.
MAX_INTENTOS_PROCESAMIENTO=

# OPCIONAL. Fecha ISO de corte para integrar sesiones aprobadas al contexto
# longitudinal. Default: el inicio del día de hoy, para que un deploy sin la
# variable no dispare la integración retroactiva de todo el histórico.
CONTEXTO_DESDE=

# ----------------------------------------------------------------------------
# Cron (recordatorios y salud)
# ----------------------------------------------------------------------------
# Protege /api/cron/*. Generar con: openssl rand -base64 32
CRON_SECRET="reemplazar-por-openssl-rand-base64-32"

# A dónde llega toda alerta del sistema (cron de salud, fallos del despacho de
# SMS): un correo por Resend (RESEND_API_KEY). Obligatoria en producción:
# /api/health contesta 503 si falta. La lista completa de variables de
# operación está en src/lib/env-operacion.ts.
ALERTA_CORREO=

# ----------------------------------------------------------------------------
# Anthropic (asistente de ayuda)
# ----------------------------------------------------------------------------
# Clave de la API que contesta las preguntas del panel de ayuda (Lupita), en
# /api/ayuda. Se saca de console.anthropic.com y empieza con "sk-ant-".
# Sin ella la app arranca y todo lo demás funciona: el panel de ayuda contesta
# que no está disponible y lo deja anotado en el log de la función. El modelo
# no es configurable por entorno (MODELO_AYUDA en src/lib/anthropic-mensajes.ts).
# Es la misma variable que lee processor/.env para el análisis clínico, pero
# son dos entornos distintos: hay que ponerla en los dos.
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# Cloudflare R2 (audio cifrado)
# ----------------------------------------------------------------------------
# Las cuatro son necesarias juntas: si falta una, r2Configurado() da false y
# la grabación queda deshabilitada (la app igual arranca).
# ID de cuenta de Cloudflare; forma el endpoint <id>.r2.cloudflarestorage.com.
R2_ACCOUNT_ID=
# Access key del token de R2 con permiso de lectura/escritura sobre el bucket.
R2_ACCESS_KEY_ID=
# Secret del mismo token. Rotar si se filtra.
R2_SECRET_ACCESS_KEY=
# Nombre del bucket donde vive el audio cifrado.
R2_BUCKET_NAME="sesion-audio"
# Origen EXACTO al que el navegador hace PUT del audio (la CSP lo declara en
# connect-src). Es el origen de la URL prefirmada, que lleva el BUCKET como
# primer subdominio (estilo virtual-hosted del SDK de S3):
#   https://<R2_BUCKET_NAME>.<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Sin comodín, sin ruta. Para verificarlo: pedir una URL de subida desde la
# app y comparar el origen. Obligatoria en producción; sin ella R2 queda
# fuera de la política y /api/health contesta 503.
R2_PUBLIC_HOST="https://sesion-audio.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.r2.cloudflarestorage.com"

# ----------------------------------------------------------------------------
# Twilio SMS (subcuenta dedicada a Sesión)
# ----------------------------------------------------------------------------
# Account SID de la subcuenta (no el de la cuenta master).
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Auth Token de la subcuenta. Rotar si se filtra.
TWILIO_AUTH_TOKEN=

# Número emisor en E.164, comprado en Twilio (Uruguay no soporta sender ID
# alfanumérico). Si falta, el cron de recordatorios queda desactivado y no
# toca ningún registro.
TWILIO_SMS_FROM="+598XXXXXXXXX"

# ----------------------------------------------------------------------------
# Sentry (OPCIONAL)
# ----------------------------------------------------------------------------
# Sin estas dos, Sentry no se inicializa y la app funciona igual.
# SENTRY_DSN es del lado server (instrumentation.ts); NEXT_PUBLIC_SENTRY_DSN se
# expone al browser (instrumentation-client.ts). Suele ser el mismo DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
