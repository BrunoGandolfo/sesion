# Base de datos PostgreSQL en Neon
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
# Generar con: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3001"

# WhatsApp
# Hoy usa Evolution API; el objetivo es migrar a Twilio / Cloud API oficial.
WHATSAPP_API_URL="https://api.twilio.com"
WHATSAPP_API_KEY="your-twilio-auth-token"
WHATSAPP_INSTANCE="your-twilio-account-sid"

# Cron job
# Usar un secreto aleatorio fuerte para proteger endpoints programados.
CRON_SECRET="generate-a-random-secret-here"

# Seed solo para desarrollo
# Usar un secreto aleatorio y una contraseña fuerte para el usuario inicial.
SEED_SECRET="generate-a-random-secret-here"
SEED_USER_PASSWORD="a-strong-password-for-initial-user"
