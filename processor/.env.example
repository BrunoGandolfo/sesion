# Sesión Processor — Variables de entorno
# Copiar a .env y completar los valores

# App Sesión (Vercel)
APP_BASE_URL=https://sesion-seven.vercel.app
PROCESSING_SECRET=<token Bearer para auth M2M>

# Cloudflare R2 (almacenamiento de audio)
R2_ENDPOINT=<endpoint del bucket R2>
R2_ACCESS_KEY_ID=<access key>
R2_SECRET_ACCESS_KEY=<secret key>
R2_BUCKET_NAME=sesion-audio

# VibeVoice-ASR (transcripción + diarización)
VIBEVOICE_URL=http://100.71.155.25:8090/transcribe
VIBEVOICE_HEALTH_URL=http://100.71.155.25:8090/health

# Ollama (nota clínica SOAP)
OLLAMA_BASE_URL=http://100.71.155.25:11434
LLM_MODEL_ID=qwen3.6:27b
LLM_BACKEND=ollama

# Worker
POLL_INTERVAL_SECONDS=30
AUDIO_TEMP_DIR=/tmp/sesion-audio
