# Sesión Processor — Variables de entorno (Ola 3: AssemblyAI + Anthropic, Railway)
# Copiar a .env para correr local; en Railway cargarlas como Variables del servicio.

# App Sesión (Vercel)
APP_BASE_URL=https://<dominio-de-la-app>
PROCESSING_SECRET=<token Bearer para auth M2M>

# Cloudflare R2 (audio cifrado)
R2_ENDPOINT=<https://<account-id>.r2.cloudflarestorage.com>
R2_ACCESS_KEY_ID=<access key>
R2_SECRET_ACCESS_KEY=<secret key>
R2_BUCKET_NAME=sesion-audio

# ASR — AssemblyAI
ASSEMBLYAI_API_KEY=<api key>
# Confirmar el identificador vigente de Universal-3.5 Pro en docs.assemblyai.com
ASR_MODEL_ID=universal-3-pro
ASR_POLL_SECONDS=10
ASR_TIMEOUT_SECONDS=1800

# LLM — Anthropic
ANTHROPIC_API_KEY=<api key>
LLM_BACKEND=anthropic
LLM_MODEL_ID=claude-sonnet-5
# low | medium | high | xhigh | max (vacío = default del modelo)
LLM_EFFORT=medium
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=300

# Worker
POLL_INTERVAL_SECONDS=30
WORKER_VERSION=ola3
