[Unit]
Description=Sesion clinical processor worker
Documentation=https://github.com/brunogandolfo/sesion
# Tailscale es el único camino para llegar a la app en Vercel desde La Escondida
# y al ASR/LLM en Atlas. Si tailscaled no está arriba, el worker arranca pero
# falla al primer poll y entra en backoff hasta que la red converge.
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

# Backoff: hasta 5 reinicios en 5 min; si supera ese umbral systemd deja el
# servicio en estado failed y hay que intervenir manualmente.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bruno
Group=bruno
WorkingDirectory=/home/bruno/sesion/processor

# Las variables se inyectan desde el .env del worker. systemd parsea KEY=value
# por línea, sin expansión de shell — el .env.example del repo respeta ese
# formato.
EnvironmentFile=/home/bruno/sesion/processor/.env

# Logs sin buffer y sin .pyc en el WorkingDirectory (el home queda limpio).
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=/home/bruno/sesion/processor/venv/bin/python /home/bruno/sesion/processor/worker.py

Restart=on-failure
RestartSec=10

# SIGTERM le pide al worker terminar la sesión actual antes de cortar. Una
# sesión de 90 min puede tardar varios minutos en transcribir + nota clínica;
# damos hasta 30 min antes de que systemd mande SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=1800

# Logging a journald — visible con `journalctl -u sesion-worker -f`.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sesion-worker

# Hardening mínimo. PrivateTmp aísla /tmp/sesion-audio del resto del sistema
# y ProtectSystem=full hace read-only /usr, /boot y /etc. El home queda escribible
# para no romper el WorkingDirectory ni el venv.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
