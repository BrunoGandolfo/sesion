generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Organizaciones — multi-tenant desde el día 1
// En el MVP hay una sola fila. Cuando escale
// a SaaS, no tocamos el modelo.
// ============================================

model Organization {
  id       String   @id @default(cuid())
  nombre   String
  creadoEn DateTime @default(now()) @map("creado_en")

  configuracion    Configuracion?
  pacientes        Paciente[]
  turnos           Turno[]
  usuarios         User[]
  consentimientos  ConsentimientoGrabacion[]
  sesionesClinicas SesionClinica[]

  @@map("organizaciones")
}

// ============================================
// Auth — single user en MVP, multi-user en SaaS
// ============================================

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String   @map("hashed_password")
  nombre         String
  organizationId String   @map("organization_id")
  creadoEn       DateTime @default(now()) @map("creado_en")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("usuarios")
}

// ============================================
// Configuración — singleton por organización
// ============================================

model Configuracion {
  id                   String @id @default(cuid())
  nombreProfesional    String @map("nombre_profesional")
  direccion            String @default("")
  whatsappOrigen       String @default("") @map("whatsapp_origen")
  tarifaDefault        Int    @map("tarifa_default")
  horasAnticipacion    Int    @default(24) @map("horas_anticipacion")
  templateRecordatorio String @default("Hola {{nombre}}. Te recordamos tu sesión:\n{{fecha}}  |  {{hora}}\n{{direccion}}\n\nCualquier cambio, avisame con anticipación. Gracias.") @map("template_recordatorio")

  organizationId String       @unique @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("configuraciones")
}

// ============================================
// Pacientes
// ============================================

model Paciente {
  id            String   @id @default(cuid())
  nombre        String
  apellido      String
  telefono      String
  email         String?
  tarifa        Int
  notas         String?  @db.Text
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  organizationId  String                    @map("organization_id")
  organization    Organization              @relation(fields: [organizationId], references: [id])
  turnos          Turno[]
  consentimientos ConsentimientoGrabacion[]

  @@index([organizationId, activo])
  @@index([organizationId, apellido])
  @@map("pacientes")
}

// ============================================
// Turnos — con pago inline
// ============================================

model Turno {
  id            String    @id @default(cuid())
  fecha         DateTime
  duracion      Int       @default(50)
  modalidad     String    @default("presencial")
  estado        String    @default("programado")
  tarifaCobrada Int       @map("tarifa_cobrada")
  pagoEstado    String    @default("pendiente") @map("pago_estado")
  pagoFecha     DateTime? @map("pago_fecha")
  pagoMetodo    String?   @map("pago_metodo")
  notas         String?   @db.Text
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")

  pacienteId     String         @map("paciente_id")
  paciente       Paciente       @relation(fields: [pacienteId], references: [id])
  organizationId String         @map("organization_id")
  organization   Organization   @relation(fields: [organizationId], references: [id])
  recordatorios  Recordatorio[]
  sesionClinica  SesionClinica?

  @@index([organizationId, fecha])
  @@index([organizationId, pagoEstado])
  @@index([pacienteId])
  @@map("turnos")
}

// ============================================
// Recordatorios de WhatsApp
// ============================================

model Recordatorio {
  id            String    @id @default(cuid())
  programadoEn  DateTime  @map("programado_en")
  enviadoEn     DateTime? @map("enviado_en")
  estado        String    @default("pendiente")
  textoEnviado  String?   @map("texto_enviado") @db.Text
  error         String?   @db.Text
  intentos      Int       @default(0)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")

  turnoId String @map("turno_id")
  turno   Turno  @relation(fields: [turnoId], references: [id])

  @@index([estado, programadoEn])
  @@map("recordatorios")
}

// ============================================
// Consentimiento para grabación de sesiones
// ============================================

model ConsentimientoGrabacion {
  id             String       @id @default(cuid())
  pacienteId     String
  paciente       Paciente     @relation(fields: [pacienteId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  firmadoEn     DateTime // Timestamp de la firma
  revocadoEn    DateTime? // Null = vigente, con fecha = revocado
  textoVersion  String // Versión del texto de consentimiento firmado (ej: "1.0")
  textoCompleto String    @db.Text // Texto íntegro que el paciente firmó
  firmaDigital  String // Representación de la firma (base64 del canvas)
  ipOrigen      String? // IP desde donde se firmó (auditoría)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pacienteId])
  @@index([organizationId])
  @@map("consentimientos_grabacion")
}

// ============================================
// Sesión clínica — datos generados por IA
// a partir de la grabación de un turno realizado.
// ============================================

model SesionClinica {
  id             String       @id @default(cuid())
  turnoId        String       @unique // Relación 1:1 con Turno
  turno          Turno        @relation(fields: [turnoId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Estado del pipeline
  estado String @default("pendiente")
  // Valores: pendiente | grabando | subiendo | procesando | revision | aprobado | error

  // Audio
  duracionAudioSeg Int? // Duración del audio en segundos
  audioR2Key       String? // Key del audio cifrado en R2 (null después de borrar)
  audioBorradoEn   DateTime? // Cuándo se borró el audio

  // Transcripción (cifrada en DB)
  transcripcion String? @db.Text // Transcripción diarizada completa

  // Nota SOAP generada por IA
  notaSubjetivo String? @db.Text // S: lo que expresó el paciente
  notaObjetivo  String? @db.Text // O: lo que observó la terapeuta
  notaAnalisis  String? @db.Text // A: progreso, alianza, alertas
  notaPlan      String? @db.Text // P: compromisos, temas a retomar

  // JSON estructurado extraído por IA
  datosEstructurados String? @db.Text // JSON: temas, emociones, alianza, alertas, etc.

  // Metadatos de procesamiento
  modeloASR   String? // Ej: "qwen3-asr-1.7b"
  modeloLLM   String? // Ej: "qwen3.5-72b-q4"
  procesadoEn DateTime? // Cuándo terminó el procesamiento
  error       String?   @db.Text // Detalle del error si estado = "error"
  intentos    Int       @default(0)

  // Aprobación por la profesional
  aprobadoEn   DateTime? // Cuándo Mariana aprobó la nota
  notasEdicion String?   @db.Text // Ediciones manuales de Mariana (si las hubo)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([estado])
  @@map("sesiones_clinicas")
}
