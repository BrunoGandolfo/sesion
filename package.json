{
  "name": "sesion",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "TZ=UTC vitest run",
    "test:unit": "VITEST_SUITE=unit vitest run",
    "test:integration": "VITEST_SUITE=integration vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:test:up": "docker compose up -d --wait postgres-test && DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:25433/sesion_test prisma migrate deploy",
    "db:test:down": "docker compose down -v",
    "guardias": "node scripts/ci/max-duration.mjs && node scripts/ci/acta-vigente.mjs && node scripts/ci/migraciones.mjs --sin-drift",
    "e2e": "node pruebas/e2e/recorrido.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "3.1135.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.75.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "prisma": "^5.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.0",
    "playwright": "1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
